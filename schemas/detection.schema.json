{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/detection-as-code/schemas/detection.schema.json",
  "title": "Detection Rule",
  "description": "Contract for a single platform-agnostic detection rule. Anything a downstream job (build, review, deploy) is allowed to assume about a rule file is declared here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "detection"],

  "properties": {
    "metadata": { "$ref": "#/$defs/metadata" },
    "detection": { "$ref": "#/$defs/detection" }
  },

  "$defs": {

    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "description", "author", "created", "modified",
        "version", "status", "severity", "confidence",
        "mitre", "data_sources", "platforms"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{2,4}-[A-Z]{2,4}-[0-9]{3}$",
          "description": "Stable rule identifier: <CATEGORY>-<SUBJECT>-<NNN>, e.g. ID-AD-001. Never reused, never renumbered."
        },
        "name": { "type": "string", "minLength": 8, "maxLength": 120 },
        "description": {
          "type": "string",
          "minLength": 40,
          "description": "What the rule looks for, why it matters, and what an analyst should expect to see. Ends up in the alert body, so write it for the person on shift at 3am."
        },
        "author": { "type": "string", "minLength": 2 },
        "created": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "modified": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "status": {
          "enum": ["draft", "experimental", "stable", "deprecated"],
          "description": "draft = not deployed; experimental = deployed behind a soak window; stable = production; deprecated = kept for history, never built."
        },
        "status_reason": { "type": "string", "minLength": 5 },
        "severity": { "enum": ["informational", "low", "medium", "high", "critical"] },
        "confidence": {
          "enum": ["low", "medium", "high"],
          "description": "How strongly a hit implies real malicious activity, independent of severity. Low confidence + high severity is a valid combination and tells triage to corroborate first."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
          "uniqueItems": true
        },
        "mitre": { "$ref": "#/$defs/mitre" },
        "data_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 },
          "description": "Log sources the rule depends on, in vendor-neutral terms (e.g. 'Windows Security Event Log', 'DNS Query Logs'). Drives coverage reporting and onboarding checklists."
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["splunk", "sentinel", "elastic"] },
          "description": "Analytics platforms this rule ships to. Every entry must have a matching block under `detection`, and vice versa."
        },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "risk": { "$ref": "#/$defs/risk" },
        "false_positives": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 10 },
          "description": "Known benign causes. Each entry should be specific enough that an analyst can confirm or rule it out."
        },
        "triage": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 10 },
          "description": "Ordered investigation steps. This is the rule's contribution to the runbook."
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      }
    },

    "mitre": {
      "description": "ATT&CK coverage. One entry per tactic/technique pair; list every pair the rule genuinely covers rather than stretching one mapping.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tactic", "tactic_id", "technique", "technique_id"],
        "properties": {
          "tactic": { "type": "string", "minLength": 4 },
          "tactic_id": { "type": "string", "pattern": "^TA[0-9]{4}$" },
          "technique": { "type": "string", "minLength": 4 },
          "technique_id": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" }
        }
      }
    },

    "lifecycle": {
      "description": "Soak-test bookkeeping. A rule in `experimental` runs in the SIEM but is expected to be reviewed and either promoted or retired once its window closes.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "soak_started": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "soak_days": { "type": "integer", "minimum": 1, "maximum": 180 },
        "promoted": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "owner": { "type": "string", "minLength": 2 }
      }
    },

    "risk": {
      "description": "Platform-neutral description of what the alert is about, rendered into notable-event / incident metadata by the build stage.",
      "type": "object",
      "additionalProperties": false,
      "required": ["objects", "message"],
      "properties": {
        "objects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "type", "score"],
            "properties": {
              "field": { "type": "string", "minLength": 1, "description": "Name of a field the query actually emits." },
              "type": { "enum": ["user", "system", "network", "process", "file", "application"] },
              "score": { "type": "integer", "minimum": 0, "maximum": 100 }
            }
          }
        },
        "message": {
          "type": "string",
          "minLength": 20,
          "description": "One-line alert summary. Use $field$ placeholders that the query emits."
        }
      }
    },

    "detection": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "splunk": { "$ref": "#/$defs/splunk_block" },
        "sentinel": { "$ref": "#/$defs/sentinel_block" },
        "elastic": { "$ref": "#/$defs/elastic_block" }
      }
    },

    "splunk_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schedule", "query"],
      "properties": {
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cron", "earliest", "latest"],
          "properties": {
            "cron": { "type": "string", "minLength": 9 },
            "earliest": { "type": "string", "minLength": 2 },
            "latest": { "type": "string", "minLength": 3 }
          }
        },
        "query": { "type": "string", "minLength": 30 },
        "throttle": { "$ref": "#/$defs/throttle" }
      }
    },

    "sentinel_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schedule", "query"],
      "properties": {
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["frequency", "lookback"],
          "properties": {
            "frequency": { "type": "string", "pattern": "^PT?[0-9]+[MHD]$" },
            "lookback": { "type": "string", "pattern": "^PT?[0-9]+[MHD]$" }
          }
        },
        "query": { "type": "string", "minLength": 30 },
        "throttle": { "$ref": "#/$defs/throttle" }
      }
    },

    "elastic_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schedule", "query"],
      "properties": {
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["interval", "lookback"],
          "properties": {
            "interval": { "type": "string", "pattern": "^[0-9]+[smhd]$" },
            "lookback": { "type": "string", "pattern": "^[0-9]+[smhd]$" }
          }
        },
        "query": { "type": "string", "minLength": 30 },
        "throttle": { "$ref": "#/$defs/throttle" }
      }
    },

    "throttle": {
      "description": "Alert de-duplication. Without it, a noisy source can generate one incident per scheduled run.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "period"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "period": { "type": "string", "pattern": "^[0-9]+[mhd]$" }
      }
    }
  }
}
